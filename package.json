{
  "name": "kpi-knowledge-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة معرفية تفاعلية لـ 75 مؤشر أداء رئيسي (KPI) — مبنية على تصنيف Bernard Marr (2012)",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "typecheck": "node scripts/build.mjs --gen && tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "playwright": "^1.50.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
